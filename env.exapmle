PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/tanzania_data_hub
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d
ADMIN_NAME=Platform Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeThisPassword123!

# Configure only after receiving credentials from your licensed payment provider.
PAYMENT_PROVIDER=not_configured
PAYMENT_API_BASE_URL=
PAYMENT_API_KEY=
PAYMENT_API_SECRET=
PAYMENT_CALLBACK_URL=https://your-domain.example/api/payments/callback

# Configure a legitimate bundle distributor API before enabling automatic fulfilment.
BUNDLE_PROVIDER=not_configured
BUNDLE_API_BASE_URL=
BUNDLE_API_KEY=
BUNDLE_API_SECRET=

# OptimaPay Global API - Tanzania collection integration copied/adapted from the supplied server.js.
OPTIMAPAY_GLOBAL_BASE_URL=https://global.optimapaybridge.co.ke/api/v2
TZUG_OPTIMAPAY_API_KEY=
TZUG_OPTIMAPAY_API_SECRET=
# Optional merchant account identifier retained for provider account configuration; not sent in the Tanzania collect payload.
TZUG_OPTIMAPAY_ACCOUNT_ID=
# Set true only after confirming this merchant account is enabled for Tanzania collections.
OPTIMAPAY_TANZANIA_ENABLED=false
